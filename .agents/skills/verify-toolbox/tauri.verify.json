{
  "productName": "Toolbox Verification",
  "identifier": "com.toolbox.desktop.verify",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://127.0.0.1:9/verification-has-no-updates.json"]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Toolbox",
        "width": 1100,
        "height": 720,
        "maximized": true,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ]
  }
}
