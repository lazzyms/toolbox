# Check every file out exactly as committed. The release checks run on Windows too and read sources,
# workflows and signed fixtures byte-for-byte or with LF-anchored patterns, so no CRLF conversion.
* -text

# The generated site is compared byte-for-byte with docs/landing-pages.mjs output,
# which uses LF. Keep LF on every checkout so Windows does not convert it to CRLF.
docs/** text=auto eol=lf
