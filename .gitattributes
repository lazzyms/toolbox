# The generated site is compared byte-for-byte with docs/landing-pages.mjs output,
# which uses LF. Keep LF on every checkout so Windows does not convert it to CRLF.
docs/** text=auto eol=lf

# The pack release fixture is signed and compared byte-for-byte with what the release build makes.
# Check it out exactly as committed so Windows does not convert its JSON and key to CRLF.
ToolboxTauri/tests/fixtures/pack-release/** -text
