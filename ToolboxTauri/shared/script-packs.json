    {
      "id": "unicode-scripts-cjk",
      "name": "Unicode scripts: Chinese, Japanese and Korean",
      "scripts": [
        "Han",
        "Hiragana",
        "Katakana",
        "Hangul",
        "Bopomofo"
      ]
    }
  ],
  "packVersion": "1.0",
  "license": "OFL-1.1 AND Apache-2.0",
  "description": "Adds fonts for writing systems beyond Latin, Cyrillic and Greek so Edit PDF can show and add text in them, and Convert to PDF and Formatted PDF can write documents in them.",
