<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  AD-HOC BUILDS ONLY. Do not use this for a release.

	  Library Validation (part of the Hardened Runtime) requires every loaded
	  library to share the main executable's Team ID. Ad-hoc signatures have no
	  Team ID at all, so dyld refuses to load the embedded Sparkle.framework:

	    "not valid for use in process: mapping process and mapped file
	     (non-platform) have different Team IDs"

	  Disabling library validation is the only way to run an ad-hoc build that
	  loads a framework. The cost is real: it also permits *any* unsigned dylib
	  to be injected into the app.

	  Builds signed with a Developer ID use Resources/Toolbox.entitlements
	  instead, which keeps library validation enabled. Team IDs match there, so
	  the framework loads without weakening anything.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<key>com.apple.security.cs.allow-jit</key>
	<false/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<false/>
</dict>
</plist>
