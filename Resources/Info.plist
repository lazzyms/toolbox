<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Toolbox</string>
	<key>CFBundleDisplayName</key>
	<string>Toolbox</string>
	<key>CFBundleIdentifier</key>
	<string>com.mauliksompura.toolbox</string>
	<key>CFBundleExecutable</key>
	<string>Toolbox</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>Free to use and share.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- ===== Sparkle auto-update ===== -->
	<!-- Where to look for new versions. Served over HTTPS from GitHub Pages;
	     the signature check below is what actually establishes trust. -->
	<key>SUFeedURL</key>
	<string>https://lazzyms.github.io/toolbox/appcast.xml</string>
	<!-- Ed25519 public key. Sparkle refuses any update whose signature doesn't
	     verify against this, so the download source doesn't have to be trusted.
	     The matching private key lives only in the maintainer's Keychain. -->
	<key>SUPublicEDKey</key>
	<string>XvddDMOK0js6DYUHbIuWKdM2Gz3sMyeGh/JBMxblnTg=</string>
	<!-- No value set for SUEnableAutomaticChecks: Sparkle then asks the user on
	     first launch instead of silently checking, so no network request happens
	     before they have agreed. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Download and install in the background once permission is granted;
	     the user still confirms the relaunch. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
